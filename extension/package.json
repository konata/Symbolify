{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "symbolify",
  "title": "Symbolify",
  "description": "IntelliJ-style symbol search over ctags-generated indexes (AOSP etc.) for tinycast",
  "icon": "symbolify.png",
  "author": "konata",
  "commands": [
    {
      "name": "index",
      "title": "Symbolify",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "src1On",
      "title": "Source 1",
      "label": "Enabled",
      "type": "checkbox",
      "default": false
    },
    {
      "name": "src1Name",
      "title": "Source 1 · Name",
      "type": "textfield",
      "required": false,
      "placeholder": "aosp-16.0.0_r1"
    },
    {
      "name": "src1Json",
      "title": "Source 1 · Symbols JSON",
      "type": "file",
      "required": false,
      "description": "Symbol index generated by bun tools/generate.js"
    },
    {
      "name": "src1Base",
      "title": "Source 1 · Base Directory",
      "type": "directory",
      "required": false,
      "description": "Required: the source tree this index was generated from"
    },
    {
      "name": "src2On",
      "title": "Source 2",
      "label": "Enabled",
      "type": "checkbox",
      "default": false
    },
    {
      "name": "src2Name",
      "title": "Source 2 · Name",
      "type": "textfield",
      "required": false
    },
    {
      "name": "src2Json",
      "title": "Source 2 · Symbols JSON",
      "type": "file",
      "required": false
    },
    {
      "name": "src2Base",
      "title": "Source 2 · Base Directory",
      "type": "directory",
      "required": false
    }
  ]
}
